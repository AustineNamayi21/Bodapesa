# ─────────────────────────────────────────────────────────────────────────────
# BodaPesa environment variables. Copy to .env for local use.
# On Vercel, set these under Settings → Environment Variables instead.
# Full walkthrough: docs/GO-LIVE.md
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────────────────────
# Leave DATABASE_URL unset to use a local SQLite file (development).
# On Vercel the Neon integration sets DATABASE_URL automatically.
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require
DATABASE_FILE=./data/bodapesa.db

# ── Security (required in production) ───────────────────────────────────────
# Generate: node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
SESSION_SECRET=bodapesa-dev-secret-change-in-production
ADMIN_EMAIL=admin@bodapesa.ke
ADMIN_PASSWORD=bodapesa2026
# Partner staff logins — in production an account is only created if set.
# STIMA_PASSWORD=
# BRITAM_PASSWORD=
# Appended to Africa's Talking callback URLs so nobody can fake messages.
# WEBHOOK_SECRET=

# ── Demonstration ───────────────────────────────────────────────────────────
# On: sample rider numbers are listed, and any registered number opens the
# rider portal with no code. Off: real riders sign in with an SMS code.
# Default: on in development, off in production. Keep OFF once any real rider exists.
# DEMO_MODE=true
# Seeds synthetic riders on first run. Default: on in development, off in production.
# SEED_DEMO_DATA=true

# ── Africa's Talking (SMS + USSD) ───────────────────────────────────────────
# No key          → simulated (nothing leaves the platform)
# AT_USERNAME=sandbox + key → provider sandbox (messages appear in AT's simulator)
# AT_USERNAME=<live app username> + key → live SMS to real phones
AT_USERNAME=sandbox
AT_API_KEY=
# Only set once a sender ID is registered — an unregistered one makes every SMS fail.
# AT_SENDER_ID=BODAPESA

# ── WhatsApp Cloud API ──────────────────────────────────────────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE_NAME=bodapesa_update
WHATSAPP_VERIFY_TOKEN=bodapesa
