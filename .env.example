# ─────────────────────────────────────────────────────────────────────────────
# BodaPesa environment variables. Copy to .env for local use.
# On Vercel, set these under Settings → Environment Variables instead.
# Full walkthrough: docs/GO-LIVE.md
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────────────────────
# Leave DATABASE_URL unset to use a local SQLite file (development).
# On Vercel the Neon integration sets DATABASE_URL automatically.
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require
DATABASE_FILE=./data/bodapesa.db

# ── Security (required in production) ───────────────────────────────────────
# Generate: node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
SESSION_SECRET=bodapesa-dev-secret-change-in-production
ADMIN_EMAIL=admin@bodapesa.ke
ADMIN_PASSWORD=bodapesa2026
# Partner staff logins — in production an account is only created if set.
# STIMA_PASSWORD=
# BRITAM_PASSWORD=
# Appended to Africa's Talking callback URLs so nobody can fake messages.
# WEBHOOK_SECRET=

# ── Demonstration ───────────────────────────────────────────────────────────
# On: sample rider numbers are listed, and any registered number opens the
# rider portal with no code. Off: real riders sign in with an SMS code.
# Default: on in development, off in production. Keep OFF once any real rider exists.
# DEMO_MODE=true
# Seeds synthetic riders on first run. Default: on in development, off in production.
# SEED_DEMO_DATA=true

# ── Africa's Talking (SMS + USSD) ───────────────────────────────────────────
# No key          → simulated (nothing leaves the platform)
# AT_USERNAME=sandbox + key → provider sandbox (messages appear in AT's simulator)
# AT_USERNAME=<live app username> + key → live SMS to real phones
AT_USERNAME=sandbox
AT_API_KEY=
# Only set once a sender ID is registered — an unregistered one makes every SMS fail.
# AT_SENDER_ID=BODAPESA

# ── WhatsApp Cloud API ──────────────────────────────────────────────────────
# Riders who message the business number get free replies for 24 hours.
# Business-initiated messages need the approved template (≈KSh 2.90 each).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE_NAME=bodapesa_update
# Any long random word; paste the same value into Meta's webhook settings.
WHATSAPP_VERIFY_TOKEN=bodapesa
# App secret (Meta app → Settings → Basic). When set, unsigned webhook calls are refused.
# WHATSAPP_APP_SECRET=
# WHATSAPP_API_VERSION=v23.0
# WHATSAPP_TEMPLATE_COST_KES=2.9

# ── Donations: M-Pesa (Safaricom Daraja STK Push) ───────────────────────────
# Leave unset → donations are simulated (demo mode only; never counted as raised).
# Get sandbox keys at https://developer.safaricom.co.ke → My Apps.
# Sandbox shortcode 174379 + the public sandbox passkey from the Daraja docs.
# MPESA_ENV=sandbox            # sandbox | production
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=             # Paybill, or Store/Head Office number for a Till
# MPESA_PASSKEY=
# For a Till number instead of a Paybill:
# MPESA_TRANSACTION_TYPE=CustomerBuyGoodsOnline
# MPESA_PARTY_B=               # the Till number

# ── Donations: card payments (Flutterwave Standard v3) ──────────────────────
# FLWSECK_TEST-… key → test mode; a live key → real charges.
# FLW_SECRET_KEY=
# Secret hash you set in Flutterwave Dashboard → Settings → Webhooks.
# FLW_WEBHOOK_HASH=

# ── Donations: public page ──────────────────────────────────────────────────
# Shown to donors as who they are giving to.
# DONATION_ORG_NAME=
# Optional fundraising goal in KES — shows a progress bar on /donate.
# DONATION_GOAL_KES=
